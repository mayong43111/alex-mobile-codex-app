HOST=127.0.0.1
PORT=4310
# Development-only Vite hot-update WebSocket port.
HMR_PORT=4311
APP_ORIGIN=http://127.0.0.1:4310
DATA_DIR=.data
# Cloud-only: configure all three together. Local development keeps SQLite/files.
SQL_SERVER=
SQL_DATABASE=
AZURE_BLOB_CONTAINER_URL=
# Example endpoint: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_MODEL_ENDPOINT=
AZURE_MODEL_DEPLOYMENT=
# Independent image_generation tool; recommended default: gpt-image-2.5-flare.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_DEPLOYMENT=
AZURE_IMAGE_FOUNDRY_RESOURCE_ID=
# Optional ARM resource ID: enables discovery of deployed Responses chat models.
AZURE_FOUNDRY_RESOURCE_ID=
# Match the audience accepted by your Azure resource.
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# Optional user-assigned managed identity client ID. Production never falls back to CLI.
AZURE_CLIENT_ID=
# Local default is azure-cli (run az login). Use managed-identity in production.
AZURE_AUTH_MODE=azure-cli
# Server-owned JSON tool definitions; credentials are environment-variable references.
TOOLS_FILE=tools.json
