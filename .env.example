HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:4310
DATA_DIR=.data
# Example endpoint: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_MODEL_ENDPOINT=
AZURE_MODEL_DEPLOYMENT=
# Match the audience accepted by your Azure resource.
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# Optional user-assigned managed identity client ID. Production never falls back to CLI.
AZURE_CLIENT_ID=
# Explicitly allow Azure CLI credentials for local development only.
AZURE_AUTH_MODE=managed-identity
# Server-owned JSON tool definitions; credentials are environment-variable references.
TOOLS_FILE=tools.json
